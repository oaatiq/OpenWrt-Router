    <!-- Welcome -->
    <string name="welcome_title">Your home network, in your pocket</string>
    <string name="welcome_subtitle">See who is connected, control the internet for the whole family and keep the connection smooth — on your OpenWrt router.</string>
    <string name="welcome_feature_devices">See every device and how much it uses, live</string>
    <string name="welcome_feature_control">Block, pause or slow down any device in one tap</string>
    <string name="welcome_feature_family">Bedtime schedules and safe browsing for kids</string>
    <string name="welcome_feature_alerts">Get notified when a new device joins</string>
    <string name="welcome_start">Add my router</string>
    <string name="welcome_requirement">Needs a router running OpenWrt 23.05 or newer with the WrtPilot package installed.</string>
    <string name="welcome_install_guide">How to install WrtPilot on the router</string>

