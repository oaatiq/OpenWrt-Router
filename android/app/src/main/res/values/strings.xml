    <string name="form_help_title">Where do I find the login?</string>
    <string name="form_help_body">WrtPilot creates a dedicated login when it is installed. To see it, run this on the router:</string>
    <string name="form_help_remote">Away from home? Use a VPN such as WireGuard or Tailscale. Never expose the router’s web interface to the internet.</string>
    <string name="cert_title">Trust this router?</string>
    <string name="cert_body">The router uses its own (self-signed) certificate. Check that the fingerprint below matches the router’s, then trust it. The app will only accept this exact certificate from now on.</string>
    <string name="cert_changed_title">The certificate has changed</string>
    <string name="cert_changed_body">The router presents a different certificate than the one you trusted. This is normal after a reset or reinstall — otherwise someone may be intercepting the connection. Only continue if you know why it changed.</string>
    <string name="cert_fingerprint">SHA-256 fingerprint</string>
    <string name="cert_verify_hint">To compare, run this on the router: wrtpilot fingerprint</string>
    <string name="cert_trust">Trust</string>
    <string name="check_connected">Connected!</string>
    <string name="check_title">What this router supports</string>
    <string name="check_agent">WrtPilot agent %1$s</string>
    <string name="check_collector">Traffic statistics are running</string>
    <string name="check_collector_off">Not running. Restart the router or run: /etc/init.d/wrtpilotd restart</string>
    <string name="check_offload_on">Flow offloading is on</string>
    <string name="check_offload_off">Flow offloading is off</string>
    <string name="check_offload_explain">Offloading skips the firewall, so per-device traffic, limits and blocking are less accurate. Turning it off is recommended.</string>
    <string name="check_offload_action">Turn off</string>
    <string name="check_shaping_exact">Per-device speed limits: precise</string>
    <string name="check_shaping_coarse">Per-device speed limits: approximate</string>
    <string name="check_shaping_hint">Install tc-tiny, kmod-sched-core and kmod-ifb on the router for precise limits.</string>
    <string name="check_sqm_yes">Smart Queue (SQM) available</string>
    <string name="check_sqm_no">Smart Queue (SQM) not installed</string>
    <string name="check_sqm_hint">Optional: install sqm-scripts to reduce lag when the connection is busy.</string>
    <string name="check_wifi_yes">Wi‑Fi control available</string>
    <string name="check_wifi_no">Wi‑Fi control not available — blocking uses the firewall only</string>
