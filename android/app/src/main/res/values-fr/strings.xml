    <string name="form_help_title">Où trouver l’identifiant ?</string>
    <string name="form_help_body">WrtPilot crée un identifiant dédié à l’installation. Pour l’afficher, lancez sur le routeur :</string>
    <string name="form_help_remote">Pas à la maison ? Utilisez un VPN comme WireGuard ou Tailscale. N’exposez jamais l’interface web du routeur sur Internet.</string>
    <string name="cert_title">Faire confiance à ce routeur ?</string>
    <string name="cert_body">Le routeur utilise son propre certificat (auto-signé). Vérifiez que l’empreinte ci-dessous correspond à celle du routeur, puis faites-lui confiance. L’application n’acceptera désormais que ce certificat précis.</string>
    <string name="cert_changed_title">Le certificat a changé</string>
    <string name="cert_changed_body">Le routeur présente un certificat différent de celui que vous avez approuvé. C’est normal après une réinitialisation ou une réinstallation ; sinon, quelqu’un intercepte peut-être la connexion. Ne continuez que si vous savez pourquoi il a changé.</string>
    <string name="cert_fingerprint">Empreinte SHA-256</string>
    <string name="cert_verify_hint">Pour comparer, lancez sur le routeur : wrtpilot fingerprint</string>
    <string name="cert_trust">Faire confiance</string>
    <string name="check_connected">Connecté !</string>
    <string name="check_title">Ce que ce routeur prend en charge</string>
    <string name="check_agent">Agent WrtPilot %1$s</string>
    <string name="check_collector">Les statistiques de trafic fonctionnent</string>
    <string name="check_collector_off">Arrêtées. Redémarrez le routeur ou lancez : /etc/init.d/wrtpilotd restart</string>
    <string name="check_offload_on">L’accélération (offloading) est activée</string>
    <string name="check_offload_off">L’accélération (offloading) est désactivée</string>
    <string name="check_offload_explain">L’offloading contourne le pare-feu : le trafic par appareil, les limites et les blocages sont moins précis. Il est conseillé de le désactiver.</string>
    <string name="check_offload_action">Désactiver</string>
    <string name="check_shaping_exact">Limites de débit par appareil : précises</string>
    <string name="check_shaping_coarse">Limites de débit par appareil : approximatives</string>
    <string name="check_shaping_hint">Installez tc-tiny, kmod-sched-core et kmod-ifb sur le routeur pour des limites précises.</string>
    <string name="check_sqm_yes">File intelligente (SQM) disponible</string>
    <string name="check_sqm_no">File intelligente (SQM) non installée</string>
    <string name="check_sqm_hint">Facultatif : installez sqm-scripts pour réduire la latence quand la connexion est chargée.</string>
    <string name="check_wifi_yes">Contrôle du Wi‑Fi disponible</string>
    <string name="check_wifi_no">Contrôle du Wi‑Fi indisponible — le blocage passe uniquement par le pare-feu</string>
    <string name="check_nftset_yes">Blocage de sites : complet</string>
    <string name="check_nftset_no">Blocage de sites : DNS uniquement (installez dnsmasq-full pour un blocage complet)</string>
    <string name="check_finish">Terminer</string>

    <string name="agent_missing_title">Installez d’abord WrtPilot sur le routeur</string>
    <string name="agent_missing_body">L’application a bien joint votre routeur, mais le paquet WrtPilot n’y est pas encore installé. Sur un ordinateur relié au routeur, ouvrez un terminal et lancez ces deux commandes (la première demande le mot de passe root du routeur) :</string>
    <string name="agent_missing_after">Elle installe tout et affiche un identifiant (utilisateur « wrtpilot »). Saisissez-le ici à la place de root, puis touchez Se connecter.</string>
    <string name="agent_install_auto_body">L’application peut l’installer pour vous maintenant avec cet identifiant root. Il ne sert qu’à l’installation : l’application passe ensuite à l’identifiant limité « wrtpilot » et ne garde pas le mot de passe root. Le routeur doit avoir accès à Internet.</string>
    <string name="agent_install_needs_root">Pour l’installer depuis l’application, saisissez ci-dessus l’utilisateur root du routeur et son mot de passe (les mêmes que pour LuCI).</string>
    <string name="agent_install_button">Installer WrtPilot</string>
    <string name="agent_installing">Installation de WrtPilot sur le routeur… Cela prend environ une minute.</string>
    <string name="agent_install_failed">L’installation a échoué. Messages du routeur :</string>
    <string name="agent_install_manual">Ou installez-le depuis un ordinateur</string>
    <string name="copy_command">Copier la commande</string>
