{
	"wrtpilot": {
		"description": "WrtPilot app: per-device control (wrtpilot ubus namespace only)",
		"read": {
			"ubus": {
				"wrtpilot": [ "status", "clients", "live", "history", "events", "groups", "qos_get", "version" ]
			}
		},
		"write": {
			"ubus": {
				"wrtpilot": [
					"set_device", "forget_device", "block", "unblock", "set_limit",
					"set_group", "delete_group", "pause", "resume",
					"qos_set", "set_offload", "apply"
				]
			}
		}
	},
	"wrtpilot-setup": {
		"description": "Setup from the app with the root login (logins with read/write '*'): read the result of the app's installation and the initial app password, or set a new one",
		"read": {
			"ubus": {
				"file": [ "read" ]
			},
			"file": {
				"/etc/wrtpilot/initial_password": [ "read" ],
				"/tmp/wrtpilot-install.log": [ "read" ],
				"/tmp/wrtpilot-install.rc": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/sbin/wrtpilot passwd *": [ "exec" ]
			}
		}
	}
}
