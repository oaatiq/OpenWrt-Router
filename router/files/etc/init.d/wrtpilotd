#!/bin/sh /etc/rc.common
# WrtPilot: statistics collector + per-group DNS resolvers.
# Firewall rules do not depend on this service: they live in nftables and
# are restored by `wrtpilot apply` on boot and by fw4 on firewall reloads.

START=95
STOP=10
USE_PROCD=1

RUN_DIR=/var/run/wrtpilot

start_service() {
	mkdir -p "$RUN_DIR"

	config_load wrtpilot
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance collector
	procd_set_param command /usr/bin/ucode -S /usr/sbin/wrtpilotd
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# per-group DNS instances; configs are written by `wrtpilot apply`
	local conf name
	for conf in "$RUN_DIR"/dnsmasq-*.conf; do
		[ -f "$conf" ] || continue
		name="${conf##*/dnsmasq-}"
		name="${name%.conf}"
		procd_open_instance "dns_$name"
		procd_set_param command /usr/sbin/dnsmasq -k -C "$conf"
		procd_set_param file "$conf"
		procd_set_param respawn
		procd_set_param stderr 1
		procd_close_instance
	done
}

boot() {
	mkdir -p "$RUN_DIR"
	/usr/sbin/wrtpilot apply --boot --quiet
	start "$@"
}

reload_service() {
	start
}

service_triggers() {
	procd_add_reload_trigger wrtpilot
}
