# WrtPilot configuration. Usually managed by the WrtPilot app; see
# https://github.com/oaatiq/OpenWrt-Router/blob/main/docs/CONFIG.md

config settings 'main'
	option enabled '1'
	# counter sampling interval in seconds
	option sample_interval '2'
	# daily totals and events are written here at most once per hour
	# (use a USB disk path to spare the flash, e.g. /mnt/usb/wrtpilot)
	option persist_path '/etc/wrtpilot'
	# networks treated as LAN (client side)
	list lan_network 'lan'
	# days of daily totals kept on the router (the app keeps more)
	option history_days '35'
	# default reaction when a device exceeds its daily quota: notify | block
	option quota_action 'notify'

# Examples (normally created by the app):
